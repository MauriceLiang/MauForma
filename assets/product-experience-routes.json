      "page_mode": "Operate",
      "audience": "shift supervisor",
      "user_job": "identify and resolve failed inventory transfers",
      "primary_action": "Open unresolved transfer",
      "priority_content": [
        "pending transfers",
        "failure reason",
        "age and owner"
      ],
      "layout_directions": [
        "queue-first",
        "exception-first"
