  "anti_patterns": [
    {
      "id": "decorative-duplicate",
      "description": "Eyebrow or overline repeats the adjacent heading without independent semantic value"
    },
    {
      "id": "fake-bilingual-brand",
      "description": "Adds ANALYSIS STUDIO / SMART DASHBOARD below product name without an established brand identity"
    },
    {
      "id": "fake-chapter-number",
      "description": "Adds 01 / Overview for decoration rather than actual steps or readable outline"
    },
    {
      "id": "developer-notes-leak",
      "description": "Shows ECharts tooltip / implementation notes in end-user interface"
    },
    {
      "id": "undersized-data-text",
